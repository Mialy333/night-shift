<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ellebuild.nightshift</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/YOUR_USER/night-shift/night_shift.py</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- colon-separated list of the repos you work in this week -->
    <key>NIGHT_SHIFT_REPOS</key>
    <string>/Users/YOUR_USER/Documents/PythonProjects/night-shift</string>
    <key>NIGHT_SHIFT_MODEL</key>
    <string>gemma3:4b</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>

  <!-- 03:00 every night. If the Mac is asleep, launchd runs it at the next wake. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/nightshift.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/nightshift.err</string>
</dict>
</plist>
